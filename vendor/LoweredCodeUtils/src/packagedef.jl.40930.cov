        1 if ccall(:jl_generating_output, Cint, ()) == 1
        1     ex = :(f(x; color::Symbol=:green) = 2x)
        1     lwr = Meta.lower(@__MODULE__, ex)
        1     frame = Frame(@__MODULE__, lwr.args[1])
        1     rename_framemethods!(frame)
        1     ex = quote
        -         s = 0
        -         k = 5
        -         for i = 1:3
        -             global s, k
        -             s += rand(1:5)
        -             k += i
        -         end
        -     end
        1     lwr = Meta.lower(@__MODULE__, ex)
        1     src = lwr.args[1]
        1     edges = CodeEdges(@__MODULE__, src)
        1     isrequired = lines_required(GlobalRef(@__MODULE__, :s), src, edges)
        1     lines_required(GlobalRef(@__MODULE__, :s), src, edges; norequire=())
        1     lines_required(GlobalRef(@__MODULE__, :s), src, edges; norequire=exclude_named_typedefs(src, edges))
        1     for isreq in (isrequired, convert(Vector{Bool}, isrequired))
        2         lines_required!(isreq, src, edges; norequire=())
        2         lines_required!(isreq, src, edges; norequire=exclude_named_typedefs(src, edges))
        2     end
        1     frame = Frame(@__MODULE__, src)

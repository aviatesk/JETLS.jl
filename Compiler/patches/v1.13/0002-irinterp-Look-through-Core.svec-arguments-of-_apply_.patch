From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ian Butterworth <i.r.butterworth@gmail.com>
Date: Mon, 26 Oct 2026 16:51:58 -0400
Subject: [PATCH] irinterp: Look through `Core.svec` arguments of
 `_apply_iterate` (#64253)

Since #59548 the optimizer rewrites the tuples splatted by `_apply_iterate`
into `Core.svec` calls. When the call cannot be turned into a direct call
(more than 32 splatted elements), the `_apply_iterate` stays in the
optimized IR with svec arguments, whose type does not record the element
types. Semi-concrete evaluation then could not splat them precisely and
returned a less precise result than constant propagation would have, and
that result was used. For example `getproperties` from ConstructionBase.jl
lost the field names of structs with more than 32 fields.

Rebuild the element types from the svec call when splatting in irinterp.

Assisted-by: Claude Code (Opus 5.5)
(cherry picked from commit daf002a659430422e5b9d463b7b7f55086deba7d)
---
 Compiler/src/abstractinterpretation.jl | 21 +++++++++++++++++++++
 Compiler/test/inference.jl             |  7 +++++++
 2 files changed, 28 insertions(+)

diff --git a/Compiler/src/abstractinterpretation.jl b/Compiler/src/abstractinterpretation.jl
index b7cda009e48706b1e5f73aa31c55765db8192590..018c1954334cd22d37bc7e4ab6e5860c393684b5 100644
--- a/Compiler/src/abstractinterpretation.jl
+++ b/Compiler/src/abstractinterpretation.jl
@@ -2779,6 +2779,24 @@ function argtypes_are_actually_getglobal(argtypes::Vector{Any})
     return isa(M.val, Module) && isa(s.val, Symbol)
 end
 
+# The optimizer turns splatted tuples into `Core.svec` calls, and the type of an svec does not
+# record its elements. Look through those calls so that splatting them stays precise.
+function svec_apply_argtypes(𝕃::AbstractLattice, fargs::Vector{Any}, argtypes::Vector{Any}, ir::IRCode)
+    newargtypes = argtypes
+    for i in 4:min(length(fargs), length(argtypes))
+        a = fargs[i]
+        isa(a, SSAValue) || continue
+        isa(argtypes[i], Const) && continue
+        stmt = ir[a][:stmt]
+        is_known_call(stmt, Core.svec, ir) || continue
+        if newargtypes === argtypes
+            newargtypes = copy(argtypes)
+        end
+        newargtypes[i] = tuple_tfunc(𝕃, Any[argextype(x, ir) for x in stmt.args[2:end]])
+    end
+    return newargtypes
+end
+
 # call where the function is known exactly
 function abstract_call_known(interp::AbstractInterpreter, @nospecialize(f),
         arginfo::ArgInfo, si::StmtInfo, sv::AbsIntState,
@@ -2790,6 +2808,9 @@ function abstract_call_known(interp::AbstractInterpreter, @nospecialize(f),
     𝕃ᵢ = typeinf_lattice(interp)
     if isa(f, Builtin)
         if f === _apply_iterate
+            if sv isa IRInterpretationState && fargs !== nothing
+                return abstract_apply(interp, svec_apply_argtypes(𝕃ᵢ, fargs, argtypes, sv.ir), si, sv)
+            end
             return abstract_apply(interp, argtypes, si, sv)
         elseif f === invoke
             return abstract_invoke(interp, arginfo, si, sv)
diff --git a/Compiler/test/inference.jl b/Compiler/test/inference.jl
index f7e0d8cb9a506a8b6fc85145725002a76951a41c..2be4c455ecd6be1a881e5bac906aed062a44b0cc 100644
--- a/Compiler/test/inference.jl
+++ b/Compiler/test/inference.jl
@@ -6777,4 +6777,11 @@ end
     Val(concrete_eval_eligible_if_false(42., 5, false) == 5sin(42.))
 end == Val{true}
 
+# irinterp must keep splats precise after the optimizer turns them into `Core.svec` calls
+const SPLAT_SVEC_NAMES = ntuple(i -> Symbol(:a, i), 33)
+@inline splat_svec_inner(names, vals...) = NamedTuple{names}(vals)
+@inline splat_svec_outer(names, vals::Tuple) = splat_svec_inner(names, vals...)
+splat_svec_caller(vals) = splat_svec_outer(SPLAT_SVEC_NAMES, vals)
+@test Base.infer_return_type(splat_svec_caller, (NTuple{33,Int},)) === NamedTuple{SPLAT_SVEC_NAMES, NTuple{33,Int}}
+
 end # module inference

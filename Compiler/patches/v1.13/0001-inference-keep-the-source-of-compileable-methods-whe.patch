From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ian Butterworth <i.r.butterworth@gmail.com>
Date: Mon, 26 Oct 2026 20:44:55 -0400
Subject: [PATCH] inference: keep the source of compileable methods when
 generating output (#64210)

Since 59d74d46f8, inference keeps the source of a method only when it is
inlineable, also while generating a cache. A `.ji` cache without native
code then has nothing for most of its methods, so whoever loads it has
to infer them all again. PackageCompiler builds sysimages from such
caches, and on 1.13 most of the time spent writing a large sysimage went
into that re-inference.

Keep the source of every compileable signature while generating output,
as 1.11 did. Caches with native code still drop it when they are saved,
so native pkgimages and Julia's own sysimage do not grow. `.ji` caches
without native code grow by about a quarter.

Assisted-by: Claude Code (Claude Opus 5.5)
(cherry picked from commit 62b4d248143ecede681d3f6d2f32bb5cf24c1a36)
---
 Compiler/src/typeinfer.jl | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/Compiler/src/typeinfer.jl b/Compiler/src/typeinfer.jl
index aa6cce7a422a7285c98585ab42c4ee4390688790..f6d15c8a8eea38857a742bf04c83c730da2e0e17 100644
--- a/Compiler/src/typeinfer.jl
+++ b/Compiler/src/typeinfer.jl
@@ -433,13 +433,19 @@ function transform_result_for_cache(interp::AbstractInterpreter, result::Inferen
     return src
 end
 
-function discard_optimized_result(interp::AbstractInterpreter, _#=::OptimizationState=#, inlining_cost#=::InlineCostType=#)
+function discard_optimized_result(interp::AbstractInterpreter, opt#=::OptimizationState=#, inlining_cost#=::InlineCostType=#)
     may_discard_trees(interp) || return false
     inlining_cost == MAX_INLINE_COST || return false
     precompile_keep_ir(interp) && return false
+    keep_source_for_output(opt.linfo) && return false
     return true
 end
 
+# A cache without native code needs the source of every compileable signature, or
+# loading it means inferring them all again. Caches with native code drop it on save.
+keep_source_for_output(mi::MethodInstance) =
+    ccall(:jl_generating_output, Cint, ()) != 0 && isa_compileable_sig(mi)
+
 function maybe_compress_codeinfo(interp::AbstractInterpreter, mi::MethodInstance, ci::CodeInfo)
     def = mi.def
     isa(def, Method) || return ci # don't compress toplevel code
@@ -450,7 +456,7 @@ function maybe_compress_codeinfo(interp::AbstractInterpreter, mi::MethodInstance
         # irgen's typeinf_ext can reuse it instead of re-inferring.
         # jl_finalize_precompile_inferred nulls it before save.
         precompile_keep_ir(interp) && return ci
-        return nothing
+        keep_source_for_output(mi) || return nothing
     end
     may_compress(interp) && return ccall(:jl_compress_ir, String, (Any, Any), def, ci)
     return ci
